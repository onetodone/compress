# Runtime
NODE_ENV=development
# API listen address and port (the worker listens on 3002 in development). Behind a reverse proxy
# use 127.0.0.1; in a container 0.0.0.0 (the default).
HOST=127.0.0.1
PORT=3001

# Google Cloud / Firebase. A "demo-" project id keeps the emulators offline.
GCP_PROJECT_ID=demo-image-compressor
CORS_ORIGINS=http://localhost:3000

# Firebase emulators (local only)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Skip the metadata server lookup (about 3 s per client) that Google auth libraries run outside
# Google Cloud to find credentials.
METADATA_SERVER_DETECTION=none
# Production only: service account key for Firestore (roles/datastore.user). Leave unset with the emulators.
# GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare R2: Account API token with Object Read & Write on the bucket (see infra/r2/README.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=image-compressor-dev

# Cloudinary (optional): API key allowed to upload and delete assets, used by the API and the worker.
# Leave CLOUDINARY_URL empty to skip previews; the browser then loads results from R2.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=image-compressor-dev

# Background jobs (BullMQ). Use a Redis database number of its own; integration tests use
# redis://127.0.0.1:6379/15 (TEST_REDIS_URL) and flush it.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_PREFIX=image-compressor
# Attempts per job; the last one fails the job and refunds its quota. Retries back off exponentially.
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=10000
# Jobs the worker compresses in parallel
QUEUE_CONCURRENCY=2

# Daily job limits of the API, per UTC day. The per-IP limit counts anonymous jobs per client
# address (IPv6 per /64) across all anonymous sessions; 0 disables it.
QUOTA_ANONYMOUS_DAILY=5
QUOTA_SIGNED_IN_DAILY=30
QUOTA_ANONYMOUS_PER_IP_DAILY=20

# Logging
SLOW_CALL_THRESHOLD_MS=1000

# Web app (public, embedded in the static export)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-image-compressor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-image-compressor
NEXT_PUBLIC_FIREBASE_APP_ID=
